  "datasets": [
    {
      "name": "sales_summary",
      "displayName": "Sales Summary",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  sales_summary"
      ],
      "catalog": "catalog_pry",
      "schema": "golden"
    },
    {
      "name": "top10_customers",
      "displayName": "Top 10 Clientes",
      "queryLines": [
        "SELECT\n",
        "  CustomerName,\n",
        "  Category,\n",
        "  SUM(TotalSales) AS TotalSales\n",
        "FROM\n",
        "  sales_summary\n",
        "GROUP BY\n",
        "  CustomerName,\n",
        "  Category\n",
        "ORDER BY\n",
        "  TotalSales DESC\n",
        "LIMIT 10"
      ],
      "catalog": "catalog_pry",
      "schema": "golden"
    }
  ],
